# Chest storage backend.
#   local = browser localStorage (default, works in dev and production build)
#   file  = JSON files in data/chests, served by the Vite dev server (dev/preview only)
VITE_STORAGE_BACKEND=local

# Base URL path for static hosting (GitHub Pages sets this automatically in CI).
# Example for a repo named "gothic": /gothic/
# VITE_BASE_PATH=/gothic/
